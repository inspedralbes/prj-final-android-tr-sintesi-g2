<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/EDSON/UI%20Menu/UI_LoadGame/Load.uss?fileID=7433441132597879392&amp;guid=d26f626d47ea2dc92b6a12150a73d9c0&amp;type=3#Load" />
    <engine:VisualElement name="ContainerText" class="mainContainer" style="flex-grow: 1;">
        <engine:Label text="Load Game&#10;" name="titleContainer" />
        <engine:Label text="Select one of the slots to load your game&#10;" />

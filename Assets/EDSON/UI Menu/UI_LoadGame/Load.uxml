    </engine:VisualElement>
    <engine:VisualElement name="ContainerButtons" class="buttonContainer" style="flex-grow: 0; justify-content: center; align-items: stretch; flex-direction: row; align-self: stretch; margin-bottom: 0; margin-top: 0; margin-right: 0; margin-left: 0; flex-wrap: nowrap; flex-shrink: 0;">
        <engine:Button text="Button" name="Slot1" style="height: 199px; width: 166px;" />
        <engine:Button text="Button" name="Slot2" style="height: 199px; width: 166px;" />
        <engine:Button text="Button" name="Slot3" style="height: 199px; width: 166px; justify-content: space-between; align-self: stretch; align-content: stretch;" />
    </engine:VisualElement>
</engine:UXML>

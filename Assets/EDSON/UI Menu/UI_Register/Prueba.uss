/* FormContainer con fondo negro */
.formContainerStyle {
    align-items: center;
    justify-content: center;
    width: 300px;
    padding: 20px;
    background-color: rgba(41, 36, 41, 0.9); /* Fondo oscuro con transparencia */
    border-radius: 12px;
    box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.5); /* Sombra para darle relieve */
}

/* Estilo del TextField */
.nicknameStyle {
    background-color: transparent; /* Fondo transparente para el campo de texto */
    border: 2px solid white; /* Borde blanco */
    border-radius: 10px; /* Bordes redondeados */
    font-size: 22px;
    padding: 14px;
    color: black; /* Color del texto ingresado */
    text-align: center;
    margin-bottom: 20px; /* Espaciado debajo del campo */
}

/* Estilo del label (Placeholder y texto) */
.nicknameStyle .unity-text-field__input {
    color: black; /* Texto ingresado en negro */
}

.nicknameStyle .unity-text-field__placeholder {
    color: white; /* Color del placeholder en blanco */
}

/* Estilo del botón de registro */
.registerButtonStyle {
    background-color: rgb(52, 152, 219);
    color: white;
    font-size: 18px;
    font-weight: bold;
    border-radius: 10px;
    border: none;
    transition: background-color 0.3s ease;
    width: 100%;
    height: 50px;
}

.registerButtonStyle:hover {
    background-color: rgb(41, 128, 185); /* Color más oscuro al hacer hover */
}

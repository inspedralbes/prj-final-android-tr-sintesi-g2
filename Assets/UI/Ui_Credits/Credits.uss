.credits-container {
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
}

.credits-scroll {
    width: 100%;
    height: 100%;
}

.credits-content {
    width: 100%;
    padding: 50px;
    align-items: center;
}

.game-title {
    font-size: 48px;
    color: #FFD700;
    -unity-font-style: bold;
    margin: 20px;
    -unity-text-align: center;
}

.section-title {
    font-size: 32px;
    color: #ADD8E6;
    margin-top: 40px;
    margin-bottom: 20px;
    -unity-text-align: center;
}

.credit-name {
    font-size: 24px;
    color: #FFFFFF;
    margin: 10px;
    -unity-text-align: center;
}

.credit-detail {
    font-size: 20px;
    color: #CCCCCC;
    margin: 5px;
    -unity-text-align: center;
}

.thank-you {
    font-size: 36px;
    color: #FFD700;
    margin-top: 40px;
    -unity-text-align: center;
}

.spacer {
    height: 100px;
}
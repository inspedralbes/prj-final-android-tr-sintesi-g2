.container {
    flex-direction: row;
    align-self: stretch;
    align-items: center;
    justify-content: space-around;
}

.buttonColorH:hover {
    color: rgb(255, 0, 0);
    transition-duration: 0.2s;
    transition-timing-function: ease;
    transition-delay: 0s;
}
